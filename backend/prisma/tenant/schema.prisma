generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@prisma/tenant-client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String      @id @default(uuid())
  email             String?     @unique
  password          String?
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  phone             String?     @unique
  roleId            String?     @map("role_id")
  loginAccess       LoginAccess @default(DISABLED) @map("login_access")
  createdById       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?   @map("deleted_at")
  // Set whenever the password changes; JWTs issued before this are rejected (force logout).
  passwordChangedAt DateTime?   @map("password_changed_at")

  role             Role?            @relation(fields: [roleId], references: [id])
  employee         Employee?
  salaryRevisions  SalaryRevision[] @relation("SalaryRevisionCreatedBy")
  payrollsApproved Payroll[]

  @@index([roleId])
  @@index([deletedAt])
  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")

  @@index([name])
  @@index([isActive])
  @@map("companies")
}

model Product {
  id                    String    @id @default(uuid())
  name                  String
  code                  String
  barcode               String?
  description           String?
  type                  String    @default("FINISHED_GOOD") @map("type")
  uomId                 String    @map("uom_id")
  categoryId            String?   @map("category_id")
  brandId               String?   @map("brand_id")
  productGroupId        String?   @map("product_group_id")
  currentStock          Float     @default(0) @map("current_stock")
  reservedStock         Float     @default(0) @map("reserved_stock")
  totalRejectedQuantity Float     @default(0) @map("total_rejected_quantity")
  minStock              Float?    @map("min_stock")
  maxStock              Float?    @map("max_stock")
  reorderLevel          Float     @default(0) @map("reorder_level")
  sellingPrice          Float?    @map("selling_price")
  costPrice             Float?    @map("cost_price")
  images                String[]  @default([])
  isActive              Boolean   @default(true) @map("is_active")
  deletedAt             DateTime? @map("deleted_at")
  createdById           String?   @map("created_by")
  updatedById           String?   @map("updated_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  attributes               ProductAttribute[]
  boms                     BOM[]
  FinancialEvent           FinancialEvent[]
  materialRequestItems     MaterialRequestItem[]
  materialTransferItems    MaterialTransferItem[]
  productionOrders         ProductionOrder[]
  productBatches           ProductBatch[]
  uom                      UOM                       @relation(fields: [uomId], references: [id])
  category                 ProductCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                    ProductBrand?             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  productGroup             ProductGroup?             @relation(fields: [productGroupId], references: [id], onDelete: Restrict)
  qualityControlProducts   QualityControl[]          @relation("QualityControlProduct")
  saleItems                SaleItem[]
  saleReturnItems          SaleReturnItem[]
  stockBalances            StockBalance[]
  stockLedgers             StockLedger[]
  stockTransactions        StockTransaction[]
  stocktakes               Stocktake[]
  warehouseStockBalances   WarehouseStockBalance[]
  wasteRecords             WasteManagement[]         @relation("WasteProduct")
  customerReturns          CustomerReturn[]
  customerOrderItems       CustomerOrderItem[]
  customerDeliveryItems    CustomerDeliveryItem[]
  branchProductPrices      BranchProductPrice[]
  branchStockBalances      BranchStockBalance[]
  branchStockRequestItems  BranchStockRequestItem[]
  branchStockTransferItems BranchStockTransferItem[]
  priceListEntries         PriceListEntry[]
  factoryStockBalance      FactoryStockBalance?
  branchStockReturnItems   BranchStockReturnItem[]
  productBonusGroupProducts ProductBonusGroupProduct[]
  productAdjustments        ProductAdjustment[]

  @@index([code])
  @@index([name])
  @@index([isActive])
  @@index([categoryId])
  @@index([brandId])
  @@index([productGroupId])
  @@map("products")
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  name      String
  value     String
  unit      String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model Location {
  id                String             @id @default(uuid())
  name              String
  address           String?
  city              String?
  state             String?
  country           String?
  lat               Float?
  lng               Float?
  phone             String?
  email             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  createdById       String?            @map("created_by")
  cashInHandRecords CashInHand[]
  expenses          Expense[]
  heldInvoices      HeldInvoice[]
  plants            Plant[]
  saleReturns       SaleReturn[]
  sites             Site[]
  stockBalances     StockBalance[]
  fromTransactions  StockTransaction[] @relation("FromLocation")
  toTransactions    StockTransaction[] @relation("ToLocation")
  stocktakes        Stocktake[]
  warehouses        Warehouse[]

  @@index([name])
  @@map("locations")
}

model StockBalance {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  locationId  String   @map("location_id")
  quantity    Float
  lastUpdated DateTime @default(now()) @map("last_updated")
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@map("stock_balances")
}

model StockTransaction {
  id               String          @id @default(uuid())
  productId        String          @map("product_id")
  fromLocationId   String?         @map("from_location_id")
  toLocationId     String?         @map("to_location_id")
  type             TransactionType
  quantity         Float
  referenceNo      String?         @map("reference_no")
  remarks          String?
  createdById      String          @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  saleId           String?         @map("sale_id")
  purchaseOrderId  String?         @map("purchase_order_id")
  saleReturnId     String?         @map("sale_return_id")
  purchaseReturnId String?         @map("purchase_return_id")
  fromLocation     Location?       @relation("FromLocation", fields: [fromLocationId], references: [id])
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  sale             Sale?           @relation(fields: [saleId], references: [id])
  saleReturn       SaleReturn?     @relation(fields: [saleReturnId], references: [id])
  purchaseReturn   PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])
  toLocation       Location?       @relation("ToLocation", fields: [toLocationId], references: [id])

  @@index([createdById])
  @@map("stock_transactions")
}

model Stocktake {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  locationId      String   @map("location_id")
  countedQuantity Float    @map("counted_quantity")
  systemQuantity  Float    @map("system_quantity")
  adjustment      Float
  performedById   String   @map("performed_by")
  createdAt       DateTime @default(now()) @map("created_at")
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stocktakes")
}

model AuditLog {
  id          String      @id @default(uuid())
  actorId     String      @map("actor_id")
  module      AuditModule @default(SYSTEM)
  entityName  String      @map("entity_name")
  entityId    String      @map("entity_id")
  entityLabel String?     @map("entity_label")
  action      AuditAction
  oldValue    Json?       @map("old_value")
  newValue    Json?       @map("new_value")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([actorId])
  @@index([module])
  @@index([entityName, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Supplier {
  id                    String    @id @default(uuid())
  name                  String
  email                 String?
  phone                 String?
  address               String?
  notes                 String?
  isActive              Boolean   @default(true) @map("is_active")
  openingBalanceAmount  Decimal?  @map("opening_balance_amount") @db.Decimal(12, 2)
  openingBalanceDate    DateTime? @map("opening_balance_date")
  openingBalanceNote    String?   @map("opening_balance_note")
  openingBalanceSetById String?   @map("opening_balance_set_by")
  deletedAt             DateTime? @map("deleted_at")
  createdById           String?   @map("created_by")
  updatedById           String?   @map("updated_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  purchaseOrders     PurchaseOrder[]
  manualTransactions SupplierTransaction[]
  bankAccounts       SupplierBankAccount[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@map("suppliers")
}

model SupplierTransaction {
  id          String                  @id @default(uuid())
  supplierId  String                  @map("supplier_id")
  date        DateTime
  type        SupplierTransactionType
  reference   String?
  description String
  debit       Decimal                 @db.Decimal(12, 2)
  credit      Decimal                 @db.Decimal(12, 2)
  notes       String?
  createdById String?                 @map("created_by")
  updatedById String?                 @map("updated_by")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  supplier    Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([date])
  @@map("supplier_transactions")
}

model SupplierBankAccount {
  id            String    @id @default(uuid())
  supplierId    String    @map("supplier_id")
  bankName      String    @map("bank_name")
  accountTitle  String    @map("account_title")
  accountNumber String    @unique @map("account_number")
  iban          String?   @unique
  swiftCode     String?   @map("swift_code")
  currency      String    @default("PKR")
  isDefault     Boolean   @default(false) @map("is_default")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdById   String?   @map("created_by")
  updatedById   String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  payments         VendorPayment[]
  purchasePayments PurchasePayment[]

  @@index([supplierId])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("supplier_bank_accounts")
}

model UOM {
  id                       String                    @id @default(uuid())
  name                     String
  symbol                   String
  code                     String                    @unique
  category                 String
  isSystem                 Boolean                   @default(false) @map("is_system")
  description              String?
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  createdById              String?                   @map("created_by")
  updatedById              String?                   @map("updated_by")
  products                 Product[]
  rawMaterials             RawMaterial[]
  grnItems                 GRNItem[]
  bomItems                 BOMItem[]
  productionOrderMaterials ProductionOrderMaterial[]
  productionOrderWastes    ProductionOrderWaste[]

  @@unique([name, category])
  @@index([code])
  @@index([category])
  @@index([isActive])
  @@map("uoms")
}

model BulkImportRecord {
  id                String    @id @default(uuid())
  fileName          String    @map("file_name")
  originalFileName  String    @map("original_file_name")
  status            String
  totalRecords      Int       @map("total_records")
  successfulRecords Int       @map("successful_records")
  failedRecords     Int       @map("failed_records")
  errors            String[]
  userId            String    @map("user_id")
  summary           Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")

  @@map("bulk_import_records")
}

enum CustomerCategoryStatus {
  ACTIVE
  INACTIVE
}

// Standalone lookup, client-managed — no fixed set of values (see ProductBrand/ProductGroup).
model CustomerCategory {
  id        String                 @id @default(uuid())
  name      String                 @unique
  status    CustomerCategoryStatus @default(ACTIVE)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  customers Customer[]

  @@index([status])
  @@map("customer_categories")
}

enum CustomerType {
  RETAILER
  WHOLESALER
  DISTRIBUTOR
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id             String         @id @default(uuid())
  code           String         @unique
  shopName       String         @map("shop_name")
  shopkeeperName String?        @map("shopkeeper_name")
  phone          String         @unique
  email          String?        @unique
  cnic           String         @unique
  customerType   CustomerType   @map("customer_type")
  categoryId     String         @map("category_id")
  paymentMode    PaymentMethod  @map("payment_mode")
  address        String
  areaId         String         @map("area_id")
  remarks        String?
  status         CustomerStatus @default(ACTIVE)
  balance        Float          @default(0)
  // Null means no limit is set yet — existing customers stay unrestricted
  // until someone explicitly sets a limit; a limit is only enforced once set.
  creditLimit    Float?         @map("credit_limit")
  // Only used in FIXED_PRICE mode — which of the 4 company-wide price lists
  // this shop pays. Every Customer in this system is a shop, so this
  // defaults to TRADE_PRICE (the "Retailer/Shop" tier) and is only ever
  // changed for the rare customer that should pay a different tier.
  priceTier      PriceListTier  @default(TRADE_PRICE) @map("price_tier")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  category           CustomerCategory      @relation(fields: [categoryId], references: [id])
  area               Area                  @relation(fields: [areaId], references: [id])
  transactions       CustomerTransaction[]
  ledgerEntries      CustomerLedger[]
  invoices           Invoice[]             @relation("SaleInvoices")
  sales              Sale[]
  heldInvoices       HeldInvoice[]         @ignore
  customerInvoices   CustomerInvoice[]     @ignore
  customerARPayments CustomerARPayment[]   @ignore
  bankAccounts       CustomerBankAccount[]
  orders             CustomerOrder[]
  deliveries         CustomerDelivery[]
  returns            CustomerReturn[]
  recoveries         CustomerRecovery[]
  ledgerAdjustments  CustomerLedgerAdjustment[]
  productAdjustments ProductAdjustment[]

  @@index([code])
  @@index([shopName])
  @@index([status])
  @@index([categoryId])
  @@index([areaId])
  @@map("customers")
}

// Legacy ledger table — owned by the `sales`/POS module only. Never written
// to by customer-management's own modules (customer-orders/deliveries/
// returns/recovery/ledger use CustomerLedger instead, a separate table)
// so the two systems can never mix or drift into each other.
model CustomerTransaction {
  id          String                  @id @default(uuid())
  customerId  String                  @map("customer_id")
  date        DateTime
  type        CustomerTransactionType
  reference   String?
  description String
  debit       Float                   @default(0)
  credit      Float                   @default(0)
  notes       String?
  createdById String?                 @map("created_by")
  updatedById String?                 @map("updated_by")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([date])
  @@map("customer_transactions")
}

// The ledger for customer-management's own modules (customer-orders,
// customer-deliveries, customer-returns, customer-recovery) — completely
// separate from CustomerTransaction (the legacy sales/POS ledger). One row
// per money-moving event; a shop's balance is always the sum of its rows,
// never a stored/updated field.
model CustomerLedger {
  id          String                  @id @default(uuid())
  customerId  String                  @map("customer_id")
  date        DateTime
  type        CustomerLedgerEntryType
  reference   String?
  // Plain id pointer to the originating CustomerDelivery/CustomerReturn/
  // CustomerRecovery row (which table depends on `type`) — not a declared
  // Prisma relation, since one FK column can't target three different tables.
  // Lets consumers resolve the source record by id instead of parsing/joining
  // on the formatted `reference` number.
  referenceId String?                 @map("reference_id")
  description String
  debit       Float                   @default(0)
  credit      Float                   @default(0)
  notes       String?
  createdById String?                 @map("created_by")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([date])
  @@index([referenceId])
  @@map("customer_ledgers")
}

model CustomerBankAccount {
  id            String    @id @default(uuid())
  customerId    String    @map("customer_id")
  bankName      String    @map("bank_name")
  accountTitle  String    @map("account_title")
  accountNumber String    @unique @map("account_number")
  iban          String?   @unique
  swiftCode     String?   @map("swift_code")
  currency      String    @default("PKR")
  isDefault     Boolean   @default(false) @map("is_default")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdById   String?   @map("created_by")
  updatedById   String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments CustomerARPayment[]

  @@index([customerId])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("customer_bank_accounts")
}

enum CustomerReturnReason {
  DAMAGED
  UNSOLD
  EXPIRED
  OTHER
}

enum CustomerOrderStatus {
  PENDING
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

// Sales Person books an order at a Shop (Customer) visit — nothing physical
// moves yet. Fulfilled later by one or more CustomerDelivery records against
// it (fully or partially). Status is recomputed from delivered quantities,
// never hand-set except CANCELLED.
model CustomerOrder {
  id            String              @id @default(uuid())
  orderNumber   String              @unique @map("order_number")
  customerId    String              @map("customer_id")
  salesPersonId String              @map("sales_person_id") @db.Uuid
  orderDate     DateTime            @default(now()) @map("order_date")
  status        CustomerOrderStatus @default(PENDING)
  totalAmount   Decimal             @map("total_amount") @db.Decimal(10, 2)
  notes         String?
  createdById   String?             @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  customer    Customer            @relation(fields: [customerId], references: [id])
  salesPerson Employee            @relation(fields: [salesPersonId], references: [id])
  items       CustomerOrderItem[]
  deliveries  CustomerDelivery[]

  @@index([customerId])
  @@index([salesPersonId])
  @@index([status])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  quantity    Float
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)

  order         CustomerOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id])
  deliveryItems CustomerDeliveryItem[]

  @@index([orderId])
  @@index([productId])
  @@map("customer_order_items")
}

enum CustomerDeliveryStatus {
  PENDING
  DELIVERED
  CANCELLED
}

// Sales Person delivers goods to a Shop (Customer) — one visit, any number of
// products (header + items, same pattern as PurchaseOrder/GRN). Created PENDING
// — either automatically alongside a CustomerOrder (same items copied over) or
// standalone. Only moves money once explicitly marked DELIVERED: that's the
// only place the matching CustomerTransaction (type SALE, debit for
// totalAmount — after discount) and order-fulfillment recalculation happen.
// Optionally fulfills a prior CustomerOrder (orderId nullable, plain FK — no
// order number string-matching involved). Sales Person and the confirming
// deliverer are both referenced via Employee directly — there is no dedicated
// SalesPerson entity yet.
model CustomerDelivery {
  id             String                 @id @default(uuid())
  deliveryNumber String                 @unique @map("delivery_number")
  customerId     String                 @map("customer_id")
  salesPersonId  String                 @map("sales_person_id") @db.Uuid
  orderId        String?                @map("order_id")
  status         CustomerDeliveryStatus @default(PENDING)
  deliveredById  String?                @map("delivered_by_id") @db.Uuid
  deliveredAt    DateTime?              @map("delivered_at")
  deliveryDate   DateTime               @default(now()) @map("delivery_date")
  subtotal       Decimal                @map("subtotal") @db.Decimal(10, 2)
  discountAmount Decimal                @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal                @map("total_amount") @db.Decimal(10, 2)
  notes          String?
  createdById    String?                @map("created_by")
  createdAt      DateTime               @default(now()) @map("created_at")

  customer    Customer               @relation(fields: [customerId], references: [id])
  salesPerson Employee               @relation(fields: [salesPersonId], references: [id])
  deliveredBy Employee?              @relation("CustomerDeliveryDeliveredBy", fields: [deliveredById], references: [id])
  order       CustomerOrder?         @relation(fields: [orderId], references: [id])
  items       CustomerDeliveryItem[]

  @@index([customerId])
  @@index([salesPersonId])
  @@index([deliveredById])
  @@index([orderId])
  @@index([status])
  @@map("customer_deliveries")
}

model CustomerDeliveryItem {
  id          String  @id @default(uuid())
  deliveryId  String  @map("delivery_id")
  productId   String  @map("product_id")
  orderItemId String? @map("order_item_id")
  quantity    Float
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)

  delivery  CustomerDelivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id])
  orderItem CustomerOrderItem? @relation(fields: [orderItemId], references: [id])
  returns   CustomerReturn[]

  @@index([deliveryId])
  @@index([productId])
  @@index([orderItemId])
  @@map("customer_delivery_items")
}

enum CustomerReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

// Shop (Customer) sends goods back to the Sales Person, against a specific
// prior CustomerDeliveryItem — quantity is the only thing the client
// supplies; product, unit price, and the shop are all derived server-side
// from that delivery item so a return can never diverge from what was
// actually delivered (see CustomerReturnsService.createCustomerReturn).
// Created PENDING; only an APPROVED return restores stock to the delivering
// Sales Person's branch and posts the CustomerLedger (type RETURN, credit)
// entry reducing what the shop owes — mirrors BranchStockRequest's
// create-then-approve pattern (see CustomerReturnsRepository.approve).
model CustomerReturn {
  id             String               @id @default(uuid())
  returnNumber   String               @unique @map("return_number")
  customerId     String               @map("customer_id")
  salesPersonId  String               @map("sales_person_id") @db.Uuid
  deliveryItemId String               @map("delivery_item_id")
  productId      String               @map("product_id")
  quantity       Float
  // Copied from CustomerDeliveryItem.unitPrice at creation time — never
  // client-supplied. See the model comment.
  unitPrice      Decimal              @map("unit_price") @db.Decimal(10, 2)
  totalAmount    Decimal              @map("total_amount") @db.Decimal(10, 2)
  reason         CustomerReturnReason
  status         CustomerReturnStatus @default(PENDING)
  approvedById   String?              @map("approved_by") @db.Uuid
  approvedAt     DateTime?            @map("approved_at")
  returnDate     DateTime             @default(now()) @map("return_date")
  notes          String?
  createdById    String?              @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

