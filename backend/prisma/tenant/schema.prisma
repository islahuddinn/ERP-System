// ─── Sales Management — Territory Hierarchy ────────────────────────────────
// Region → Zone → City → Branch → Area. Each level stores only its immediate
// parent FK; ancestors (e.g. an Area's Region) are derived via relation
// traversal (area.branch.city.zone.region) instead of being cached on the
// child, so reassigning a Zone/City/Branch to a different parent never
// leaves stale data downstream. Route is intentionally deferred.

enum TerritoryStatus {
  ACTIVE
  INACTIVE
}

// Denormalized mirror of Branch.parentBranchId (PRIMARY when null, SECONDARY
// when set) — kept in sync by BranchService on every create/update, never
// written independently. Stored so it can be filtered/indexed directly
// instead of every query re-deriving it from a null check.
enum BranchType {
  PRIMARY
  SECONDARY
}

// Top of the hierarchy — no parent. e.g. "Central", "North", "South".
model Region {
  id          String          @id @default(uuid())
  name        String          @unique
  countryName String          @map("country_name")
  status      TerritoryStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  zones Zone[]

  @@index([status])
  @@map("sales_regions")
}

// Belongs to a Region. e.g. "Lahore Zone", "Karachi Zone".
model Zone {
  id        String          @id @default(uuid())
  name      String
  regionId  String          @map("region_id")
  status    TerritoryStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  region Region @relation(fields: [regionId], references: [id])
  cities City[]

  @@unique([name, regionId])
  @@index([regionId])
  @@index([status])
  @@map("sales_zones")
}

// Belongs to a Zone. e.g. "Lahore", "Sheikhupura".
model City {
  id        String          @id @default(uuid())
  name      String
  zoneId    String          @map("zone_id")
  status    TerritoryStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  zone     Zone     @relation(fields: [zoneId], references: [id])
  branches Branch[]

  @@unique([name, zoneId])
  @@index([zoneId])
  @@index([status])
  @@map("sales_cities")
}

// Belongs to a City. Holds a distributor (Employee) and the Product Groups
// it stocks (plain UUID array — see ProductGroup below — not a join table).
// A Product Group may only be held by one branch per city; that exclusivity
// is enforced in BranchService, not at the DB level, since it spans rows.
model Branch {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  cityId          String          @map("city_id")
  // One distributor can only ever run one branch.
  distributorId   String          @unique @map("distributor_id") @db.Uuid
  address         String
  productGroupIds String[]        @map("product_group_ids")
  status          TerritoryStatus @default(ACTIVE)
  // Null means this is a top-level branch — it requests stock straight from
  // the Factory, not from another Branch. Non-null branches form a tree
  // under a top-level branch (e.g. a Secondary Distributor sitting under a
  // Primary Distributor).
  parentBranchId  String?         @map("parent_branch_id")
  // Always PRIMARY when parentBranchId is null, SECONDARY otherwise — see
  // the BranchType enum doc comment.
  type            BranchType      @default(PRIMARY)
  // Only used in FIXED_PRICE mode — which of the 4 company-wide price lists
  // this branch pays when it buys stock. Null in FREE_PRICE mode, since
  // sellers set their own price there instead of reading a fixed list.
  priceTier       PriceListTier?  @map("price_tier")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  city        City     @relation(fields: [cityId], references: [id])
  distributor Employee @relation(fields: [distributorId], references: [id])
  areas       Area[]

  parentBranch  Branch?  @relation("BranchHierarchy", fields: [parentBranchId], references: [id])
  childBranches Branch[] @relation("BranchHierarchy")

  productPrices                 BranchProductPrice[]
  stockBalances                 BranchStockBalance[]
  stockRequestsAsBuyer          BranchStockRequest[]    @relation("RequesterBranch")
  stockRequestsAsSeller         BranchStockRequest[]    @relation("FulfillerBranch")
  stockTransfersOut             BranchStockTransfer[]   @relation("TransferFromBranch")
  stockTransfersIn              BranchStockTransfer[]   @relation("TransferToBranch")
  salesPersonAssignments        SalesPersonAssignment[]
  ledgerEntries                 BranchLedger[]          @relation("BranchLedgerOwner")
  ledgerEntriesAsCounterparty   BranchLedger[]          @relation("BranchLedgerCounterparty")
  stockReturnsAsReturningBranch BranchStockReturn[]     @relation("BranchStockReturnReturningBranch")
  stockReturnsAsReceivingBranch BranchStockReturn[]     @relation("BranchStockReturnReceivingBranch")

  @@unique([name, cityId])
  @@index([cityId])
  @@index([status])
  @@index([parentBranchId])
  @@index([type])
  @@map("sales_branches")
}

// Belongs to a Branch. e.g. "Garden Town".
model Area {
  id        String          @id @default(uuid())
  name      String
  branchId  String          @map("branch_id")
  status    TerritoryStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  branch    Branch     @relation(fields: [branchId], references: [id])
  customers Customer[]

  @@unique([name, branchId])
  @@index([branchId])
  @@index([status])
  @@map("sales_areas")
}

// The 4 company-wide price lists used in FIXED_PRICE mode: FACTORY_PRICE,
// DISTRIBUTOR_PRICE, TRADE_PRICE, MRP, in that order. Every buyer (a Branch
// or a Customer) is tagged with exactly one tier — the price they pay is
// always just "the PriceListEntry for my own tier and this product," never
// something a seller types in. See Branch.priceTier, Customer.priceTier.
enum PriceListTier {
  FACTORY_PRICE
  DISTRIBUTOR_PRICE
  TRADE_PRICE
  MRP
}

// One row per (tier, product) — e.g. (TRADE_PRICE, "Widget") = $14. Only
// Finance/Admin ever edits these (see price-list.manage permission); nobody
// else can set a price directly while the company is in FIXED_PRICE mode.
model PriceListEntry {
  id        String        @id @default(uuid())
  tier      PriceListTier
  productId String        @map("product_id")
  price     Decimal       @map("price") @db.Decimal(12, 2)
  updatedAt DateTime      @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tier, productId])
  @@index([tier])
  @@index([productId])
  @@map("price_list_entries")
}

// One flat price per (seller, product) — used only in FREE_PRICE mode.
// Pre-fills a BranchStockRequest, but never the final word: the seller can
// still override it per request at approval time. sellerBranchId null means
// this is the Factory's own price list.
model BranchProductPrice {
  id             String   @id @default(uuid())
  sellerBranchId String?  @map("seller_branch_id")
  productId      String   @map("product_id")
  price          Decimal  @map("price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sellerBranch Branch? @relation(fields: [sellerBranchId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sellerBranchId, productId])
  @@index([sellerBranchId])
  @@index([productId])
  @@map("branch_product_prices")
}

// Current quantity of a product physically held at a branch. Only ever
// written by BranchStockTransfer moving through DISPATCHED/RECEIVED — never
// updated directly by a user action.
model BranchStockBalance {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  productId String   @map("product_id")
  quantity  Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
  @@map("branch_stock_balances")
}

// Current quantity of a product physically held at the Factory — the single
// top-of-chain source every top-level Branch draws from (see Branch.parentBranchId,
// BranchStockRequest.fulfillerBranchId, BranchStockTransfer.fromBranchId — all
// null-means-Factory). One row per product; there is only ever one Factory, so
// no separate Factory entity/FK exists here. Written by stock-in/adjust
// (FactoryStockService) and decremented when a transfer sourced from the
// Factory is dispatched — never updated directly any other way.
model FactoryStockBalance {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  quantity  Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("factory_stock_balances")
}

enum BranchStockRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A branch asking its parent branch (or the Factory, when requesterBranch has
// no parent) for stock. The requester never sets a price — items are created
// with unitPrice null and stay that way until the fulfiller approves, at
// which point the price locks and a linked BranchStockTransfer is created in
// the same transaction (see BranchStockRequestsRepository.approve).
model BranchStockRequest {
  id                String                   @id @default(uuid())
  requestNumber     String                   @unique @map("request_number")
  requesterBranchId String                   @map("requester_branch_id")
  // Null means the request goes to the Factory — only valid when the
  // requester branch itself has no parentBranchId.
  fulfillerBranchId String?                  @map("fulfiller_branch_id")
  status            BranchStockRequestStatus @default(PENDING)
  requestedById     String                   @map("requested_by") @db.Uuid
  approvedById      String?                  @map("approved_by") @db.Uuid
  requestDate       DateTime                 @default(now()) @map("request_date")
  approvedAt        DateTime?                @map("approved_at")
  notes             String?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  requesterBranch Branch                   @relation("RequesterBranch", fields: [requesterBranchId], references: [id])
  fulfillerBranch Branch?                  @relation("FulfillerBranch", fields: [fulfillerBranchId], references: [id])
  requestedBy     Employee                 @relation("BranchStockRequestedBy", fields: [requestedById], references: [id])
  approvedBy      Employee?                @relation("BranchStockApprovedBy", fields: [approvedById], references: [id])
  items           BranchStockRequestItem[]
  // 1:many — an APPROVED request can be fulfilled across several transfers
  // over time (partial dispatch now, the rest later) rather than exactly
  // one. See BranchStockRequestsRepository.computeRemainingBalance.
  transfers       BranchStockTransfer[]

  @@index([requesterBranchId])
  @@index([fulfillerBranchId])
  @@index([status])
  @@map("branch_stock_requests")
}

model BranchStockRequestItem {
  id          String   @id @default(uuid())
  requestId   String   @map("request_id")
  productId   String   @map("product_id")
  quantity    Float
  // Resolved server-side and set at request creation, all-or-nothing —
  // creation fails outright if any item can't be priced — then frozen,
  // never changed again (see BranchStockRequestsService.createBranchStockRequest).
  unitPrice   Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalAmount Decimal? @map("total_amount") @db.Decimal(12, 2)

  request       BranchStockRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product       Product                   @relation(fields: [productId], references: [id])
  transferItems BranchStockTransferItem[]

  @@index([requestId])
  @@map("branch_stock_request_items")
}

enum BranchStockTransferStatus {
  PENDING
  DISPATCHED
  RECEIVED
  CANCELLED
}

/**
 * Created only against an APPROVED request, and only ever created already
 * shipped — "creating a transfer" and "dispatching it" are the same action
 * (see BranchStockRequestsRepository.shipRequestItems), never two separate
 * steps. Stock leaves fromBranch's BranchStockBalance at creation time and
 * lands in toBranch's at RECEIVED. fromBranchId null means the source is
 * the Factory, which has no BranchStockBalance of its own in this phase.
 * PENDING exists in the status enum but is never produced by current code —
 * left in place rather than migrated away, since dropping a Postgres enum
 * value requires recreating the type.
 * requestId is NOT unique — one request can be fulfilled across several
 * transfers (installment delivery, or a follow-up shipment covering a
 * previous shipment's shortfall). See computeRemainingBalance for how much
 * of a request is still outstanding across all of its transfers.
 */
model BranchStockTransfer {
  id             String                    @id @default(uuid())
  transferNumber String                    @unique @map("transfer_number")
  fromBranchId   String?                   @map("from_branch_id")
  toBranchId     String                    @map("to_branch_id")
  requestId      String                    @map("request_id")
  status         BranchStockTransferStatus @default(DISPATCHED)
  dispatchedById String?                   @map("dispatched_by") @db.Uuid
  dispatchedAt   DateTime?                 @map("dispatched_at")
  receivedById   String?                   @map("received_by") @db.Uuid
  receivedAt     DateTime?                 @map("received_at")
  cancelledById  String?                   @map("cancelled_by") @db.Uuid
  cancelledAt    DateTime?                 @map("cancelled_at")
  subtotal       Decimal                   @default(0) @map("subtotal") @db.Decimal(12, 2)
  totalAmount    Decimal                   @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt      DateTime                  @default(now()) @map("created_at")

  fromBranch      Branch?                   @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch        Branch                    @relation("TransferToBranch", fields: [toBranchId], references: [id])
  request         BranchStockRequest        @relation(fields: [requestId], references: [id])
  dispatchedBy    Employee?                 @relation("BranchStockTransferDispatchedBy", fields: [dispatchedById], references: [id])
  receivedBy      Employee?                 @relation("BranchStockTransferReceivedBy", fields: [receivedById], references: [id])
  cancelledBy     Employee?                 @relation("BranchStockTransferCancelledBy", fields: [cancelledById], references: [id])
  items           BranchStockTransferItem[]
  debtSettlements EmployeeCashTransfer[]    @relation("BranchStockTransferDebtSettlements")
  returns         BranchStockReturn[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([requestId])
  @@map("branch_stock_transfers")
}

model BranchStockTransferItem {
  id               String  @id @default(uuid())
  transferId       String  @map("transfer_id")
  productId        String  @map("product_id")
  requestItemId    String  @map("request_item_id")
  quantity         Float
  // Copied from the request item at transfer-creation time. Never re-entered
  // here — this column exists so a transfer's paper trail is self-contained,
  // not because it can diverge from the request.
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  totalAmount      Decimal @map("total_amount") @db.Decimal(12, 2)
  /**
   * A transfer is created already-shipped (see the BranchStockTransfer
   * model comment above) — `quantity` here IS what was actually dispatched,
   * decided and executed in the same call. No separate "planned vs
   * actually sent" tracking is needed at this stage; only receipt can
   * still diverge from it (goods lost/damaged after leaving the source).
   * Null until confirm-receipt. Set once, to however much of `quantity`
   * actually arrived — may be less (damage/loss in transit). The
   * destination branch's stock and ledger debit are both based on this,
   * never on `quantity`, so a branch never owes for stock it never got.
   * Any shortfall reopens as outstanding balance on the request for a
   * later shipment — see BranchStockRequestsRepository.computeRemainingBalance.
   */
  receivedQuantity Float?  @map("received_quantity")

  transfer    BranchStockTransfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product                 @relation(fields: [productId], references: [id])
  requestItem BranchStockRequestItem  @relation(fields: [requestItemId], references: [id])
  returnItems BranchStockReturnItem[]

  @@index([transferId])
  @@map("branch_stock_transfer_items")
}

enum BranchStockReturnStatus {
  PENDING
  APPROVED
  REJECTED
}

// Created only against a RECEIVED BranchStockTransfer, by the branch that
// received the stock (returningBranchId — always the original transfer's
// toBranchId). Goes back to receivingBranchId — the original transfer's
// fromBranchId — or to the Factory when that was null. Every item freezes
// its unitPrice by copying it from the originating BranchStockTransferItem
// at creation time — never re-entered — so a return is always valued at
// exactly what was paid for the stock. Created PENDING; stock only moves
// and the ledger entry only posts once APPROVED — mirrors BranchStockRequest's
// create-then-approve pattern (see BranchStockReturnsRepository.approve).
model BranchStockReturn {
  id                String                  @id @default(uuid())
  returnNumber      String                  @unique @map("return_number")
  transferId        String                  @map("transfer_id")
  returningBranchId String                  @map("returning_branch_id")
  // Null means the stock is going back to the Factory.
  receivingBranchId String?                 @map("receiving_branch_id")
  status            BranchStockReturnStatus @default(PENDING)
  requestedById     String                  @map("requested_by") @db.Uuid
  approvedById      String?                 @map("approved_by") @db.Uuid
  requestDate       DateTime                @default(now()) @map("request_date")
  approvedAt        DateTime?               @map("approved_at")
  reason            String
  subtotal          Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal                 @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  transfer        BranchStockTransfer     @relation(fields: [transferId], references: [id])
  returningBranch Branch                  @relation("BranchStockReturnReturningBranch", fields: [returningBranchId], references: [id])
  receivingBranch Branch?                 @relation("BranchStockReturnReceivingBranch", fields: [receivingBranchId], references: [id])
  requestedBy     Employee                @relation("BranchStockReturnRequestedBy", fields: [requestedById], references: [id])
  approvedBy      Employee?               @relation("BranchStockReturnApprovedBy", fields: [approvedById], references: [id])
  items           BranchStockReturnItem[]

  @@index([transferId])
  @@index([returningBranchId])
  @@index([receivingBranchId])
  @@index([status])
  @@map("branch_stock_returns")
}

model BranchStockReturnItem {
  id             String  @id @default(uuid())
  returnId       String  @map("return_id")
  transferItemId String  @map("transfer_item_id")
  productId      String  @map("product_id")
  quantity       Float
  // Copied from BranchStockTransferItem.unitPrice at return-creation time —
  // never re-entered. See the BranchStockReturn model comment.
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)

  return       BranchStockReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  transferItem BranchStockTransferItem @relation(fields: [transferItemId], references: [id])
  product      Product                 @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([transferItemId])
  @@map("branch_stock_return_items")
}

// Which Employee currently runs as the Sales Person for a branch — the
// van-stock equivalent of Branch.distributorId, which only ever names one
// person (the distributor). A branch can have several Sales People, so this
// is its own table rather than another single FK column on Branch.
model SalesPersonAssignment {
  id         String   @id @default(uuid())
  employeeId String   @unique @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("sales_person_assignments")
}

enum BranchLedgerEntryType {
  STOCK_RECEIVED // debit — written when a BranchStockTransfer is confirmed RECEIVED
  PAYMENT // credit — written when an EmployeeCashTransfer settling that same transfer's debt is confirmed RECEIVED
  STOCK_RETURNED // credit — written on the returning branch's ledger when a BranchStockReturn is APPROVED
}

// Strictly pairwise: branchId ↔ counterpartyBranchId (null counterparty means
// the Factory) are the only two parties a row ever involves — this is what
// makes the "one hop only" visibility rule enforceable by construction rather
// than by a permission check. See BranchLedgerRepository.getVisibleBranchIds.
model BranchLedger {
  id                   String                @id @default(uuid())
  branchId             String                @map("branch_id")
  // Null means the counterparty is the Factory.
  counterpartyBranchId String?               @map("counterparty_branch_id")
  date                 DateTime
  type                 BranchLedgerEntryType
  // Plain id pointer to the originating BranchStockTransfer/EmployeeCashTransfer
  // row (which table depends on `type`) — not a declared Prisma relation,
  // since one FK column can't target two different tables.
  referenceId          String?               @map("reference_id")
  // Snapshot of who ran this branch at the moment the entry was written, not
  // a live lookup — so a distributor's history survives being replaced.
  distributorIdAtTime  String?               @map("distributor_id_at_time") @db.Uuid
  description          String
  debit                Decimal               @default(0) @map("debit") @db.Decimal(12, 2)
  credit               Decimal               @default(0) @map("credit") @db.Decimal(12, 2)
  notes                String?
  createdById          String?               @map("created_by") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at")

  branch       Branch  @relation("BranchLedgerOwner", fields: [branchId], references: [id], onDelete: Cascade)
  counterparty Branch? @relation("BranchLedgerCounterparty", fields: [counterpartyBranchId], references: [id])

  @@index([branchId])
  @@index([counterpartyBranchId])
  @@index([date])
  @@map("branch_ledgers")
}

enum ProductGroupStatus {
  ACTIVE
  INACTIVE
}

// Independent classification, no parent/child. Products are tagged with a
// group; a Branch declares which groups it stocks via Branch.productGroupIds.
model ProductGroup {
  id        String             @id @default(uuid())
  name      String             @unique
  status    ProductGroupStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("product_groups")
}

enum ProductBrandStatus {
  ACTIVE
  INACTIVE
}

// Standalone classification, no parent/child relationship.
model ProductBrand {
  id        String             @id @default(uuid())
  name      String             @unique
  status    ProductBrandStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("product_brands")
}

enum ProductCategoryStatus {
  ACTIVE
  INACTIVE
}

// Standalone classification, no parent/child relationship.
model ProductCategory {
  id        String                @id @default(uuid())
  name      String                @unique
  status    ProductCategoryStatus @default(ACTIVE)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("product_categories")
}

enum ProductBonusGroupStatus {
  ACTIVE
  INACTIVE
}

// Master data: groups products that share the same bonus/scheme rules (Phase E4).
// Does not affect pricing, orders, or stock until schemes are wired in later.
model ProductBonusGroup {
  id          String                  @id @default(uuid())
  code        String                  @unique
  name        String                  @unique
  description String?
  status      ProductBonusGroupStatus @default(ACTIVE)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  products ProductBonusGroupProduct[]
  schemes  ProductBonusScheme[]

  @@index([status])
  @@map("product_bonus_groups")
}

enum ProductBonusSchemeStatus {
  ACTIVE
  INACTIVE
}

enum ProductBonusSchemeType {
  QTY_BONUS
}

// Bonus rules applied to a ProductBonusGroup. Master data only until order booking
// reads active schemes in a later phase — does not change orders/pricing/stock today.
model ProductBonusScheme {
  id                  String                   @id @default(uuid())
  code                String                   @unique
  name                String                   @unique
  description         String?
  productBonusGroupId String                   @map("product_bonus_group_id")
  type                ProductBonusSchemeType   @default(QTY_BONUS)
  minPurchaseQty      Decimal                  @map("min_purchase_qty") @db.Decimal(12, 3)
  bonusQty            Decimal                  @map("bonus_qty") @db.Decimal(12, 3)
  validFrom           DateTime                 @map("valid_from")
  validTo             DateTime?                @map("valid_to")
  status              ProductBonusSchemeStatus @default(ACTIVE)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  productBonusGroup ProductBonusGroup @relation(fields: [productBonusGroupId], references: [id], onDelete: Restrict)

  @@index([productBonusGroupId])
  @@index([status])
  @@index([validFrom])
  @@index([validTo])
  @@map("product_bonus_schemes")
}

model ProductBonusGroupProduct {
  id                  String @id @default(uuid())
  productBonusGroupId String @map("product_bonus_group_id")
  productId           String @map("product_id")

  productBonusGroup ProductBonusGroup @relation(fields: [productBonusGroupId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productBonusGroupId, productId])
  @@index([productId])
  @@map("product_bonus_group_products")
}

enum TransporterStatus {
  ACTIVE
  INACTIVE
}

// Master data for logistics vendors. Does not replace MaterialTransfer.transporterId
// (legacy user-id field) until explicitly wired in a later phase.
model Transporter {
  id                  String            @id @default(uuid())
  code                String            @unique
  name                String            @unique
  contactName         String?           @map("contact_name")
  phone               String?
  email               String?
  address             String?
  vehicleRegistration String?           @map("vehicle_registration")
  notes               String?
  status              TransporterStatus @default(ACTIVE)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([phone])
  @@map("transporters")
}

enum BrokerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Broker {
  id             String       @id @default(uuid())
  brokerCode     String       @unique @map("broker_code")
  name           String
  contactPerson  String?      @map("contact_person")
  phone          String?
  email          String?
  address        String?
  zoneId         String?      @map("zone_id")
  areaId         String?      @map("area_id")
  salesTarget    Decimal?     @default(0) @map("sales_target") @db.Decimal(12, 2)
  commissionRate Decimal      @default(0) @map("commission_rate") @db.Decimal(5, 2)
  status         BrokerStatus @default(ACTIVE)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdById    String?      @map("created_by")
  updatedById    String?      @map("updated_by")
  deletedAt      DateTime?    @map("deleted_at")

  @@index([brokerCode])
  @@index([zoneId])
  @@index([areaId])
  @@index([status])
  @@index([isActive])
  @@map("brokers")
}
