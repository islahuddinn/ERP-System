// Running balance of cash any employee is currently in custody of — not
// scoped to a "sales person" job title. Credited by CustomerRecovery (any
// employee who collects a payment from a shop, any payment mode) and by the
// receiving side of an EmployeeCashTransfer; debited by the sending side of
// an EmployeeCashTransfer. "Cash in hand" here means total custody (cash or
// otherwise), not literal banknotes.
model EmployeeCashLedger {
  id          String                      @id @default(uuid())
  employeeId  String                      @map("employee_id") @db.Uuid
  date        DateTime
  type        EmployeeCashLedgerEntryType
  reference   String?
  // Plain id pointer to the originating CustomerRecovery/EmployeeCashTransfer
  // row (which table depends on `type`) — not a declared Prisma relation, since
  // one FK column can't target two different tables. Same approach as
  // CustomerLedger.referenceId.
  referenceId String?                     @map("reference_id")
  description String
  debit       Float                       @default(0)
  credit      Float                       @default(0)
  notes       String?
  createdById String?                     @map("created_by")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([referenceId])
  @@map("employee_cash_ledgers")
}

// One employee handing custody of cash to another — sales person to branch
// manager, branch manager to HR/finance, etc.
//
// The sender's claim alone is never enough to move money on paper: a
// transfer starts PENDING and touches no ledger at all. Only once the
// RECEIVING employee confirms does it become RECEIVED and write the
// double-entry (debit sender, credit receiver) — otherwise a dishonest
// sender could clear their own balance without ever handing anything over.
// If the receiver disputes it instead, it becomes REJECTED and no ledger
// entries are ever written; the sender remains liable for that cash.
model EmployeeCashTransfer {
  id                String                     @id @default(uuid())
  transferNumber    String                     @unique @map("transfer_number")
  fromEmployeeId    String                     @map("from_employee_id") @db.Uuid
  toEmployeeId      String                     @map("to_employee_id") @db.Uuid
  amount            Decimal                    @db.Decimal(10, 2)
  status            EmployeeCashTransferStatus @default(PENDING)
  // Sender's note, editable while PENDING (create/update). Separate from
  // receiverNotes so responding never overwrites what the sender wrote.
  senderNotes       String?                    @map("sender_notes")
  // Receiver's comment, written only when they respond (confirm/reject).
  receiverNotes     String?                    @map("receiver_notes")
  transferredAt     DateTime                   @default(now()) @map("transferred_at")
  respondedAt       DateTime?                  @map("responded_at")
  createdById       String?                    @map("created_by")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  // Set only when this transfer is a branch's distributor paying down the
  // debt for one specific stock transfer they received — once the receiver
  // confirms RECEIVED, a matching BranchLedger PAYMENT credit is written
  // against that same transfer, in the same transaction (see
  // EmployeeCashTransferRepository.respond). Null for an ordinary
  // person-to-person cash handoff unrelated to stock transfer debt.
  settlesTransferId String?                    @map("settles_transfer_id")

  fromEmployee    Employee             @relation("EmployeeCashTransfersSent", fields: [fromEmployeeId], references: [id])
  toEmployee      Employee             @relation("EmployeeCashTransfersReceived", fields: [toEmployeeId], references: [id])
  settlesTransfer BranchStockTransfer? @relation("BranchStockTransferDebtSettlements", fields: [settlesTransferId], references: [id])

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([status])
  @@map("employee_cash_transfers")
}

enum EmployeeCashTransferStatus {
  PENDING // created by sender, not yet acted on by the receiver — editable by sender, no ledger effect
  RECEIVED // receiver confirmed — double-entry written, terminal
  REJECTED // receiver disputed/declined — no ledger entries, terminal
}

