// Financial models
model ChartOfAccounts {
  id            String        @id @default(uuid())
  accountCode   String        @unique
  accountName   String
  accountType   AccountType
  normalBalance NormalBalance
  parentId      String?
  isActive      Boolean       @default(true)
  description   String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdById   String?       @map("created_by_id")
  deletedAt     DateTime?     @map("deleted_at")

  // Relations
  parent       ChartOfAccounts?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccounts[] @relation("AccountHierarchy")
  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@map("chart_of_accounts")
}

model JournalEntry {
  id              String      @id @default(uuid())
  entryNumber     String      @unique
  description     String
  entryDate       DateTime    @default(now()) @map("entry_date")
  status          EntryStatus @default(DRAFT)
  totalDebit      Decimal     @map("total_debit")
  totalCredit     Decimal     @map("total_credit")
  postedAt        DateTime?   @map("posted_at")
  postedBy        String?     @map("posted_by")
  postedById      String?     @map("posted_by_id")
  reversedAt      DateTime?   @map("reversed_at")
  reversedBy      String?     @map("reversed_by")
  reversedById    String?     @map("reversed_by_id")
  reversalEntryId String?     @map("reversal_entry_id")
  sourceType      String?     @map("source_type")
  sourceId        String?     @map("source_id")
  postingKind     String?     @map("posting_kind")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  createdById     String?     @map("created_by_id")
  deletedAt       DateTime?   @map("deleted_at")

  // Relations
  journalLines    JournalLine[]
  reversalEntry   JournalEntry?  @relation("ReversalEntry", fields: [reversalEntryId], references: [id])
  reversedEntries JournalEntry[] @relation("ReversalEntry")

  @@unique([sourceType, sourceId, postingKind], map: "journal_entries_source_posting_unique")
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id           String    @id @default(uuid())
  journalId    String    @map("journal_id")
