  @@index([customerId])
  @@index([type])
  @@map("customer_ledger_adjustments")
}

enum ProductAdjustmentType {
  ADDITION
  DEDUCTION
}

// Post-sale product quantity correction record for a shop (audit document).
// Does not mutate branch stock, shop ledger, orders, or deliveries until explicitly wired later.
model ProductAdjustment {
