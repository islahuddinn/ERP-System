model Employee {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?        @unique @map("user_id")
  employeeCode  String         @unique @map("employee_code") @db.VarChar(50)
  dateOfJoining DateTime       @map("date_of_joining") @db.Timestamptz(6)
  status        EmployeeStatus @default(ACTIVE)
  shiftId       String?        @map("shift_id") @db.Uuid
  createdById   String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                           User?                  @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "fk_hr_employees_user")
  shift                          Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_hr_employees_shift")
  documents                      EmployeeDocument[]
  contracts                      EmployeeContract[]
  attendanceLogs                 AttendanceLog[]
  attendances                    Attendance[]
  leaveRequests                  LeaveRequest[]
  loanRequests                   LoanRequest[]
  rosters                        Roster[]
  overtimes                      Overtime[]
  payslips                       Payslip[]
  payrolls                       Payroll[]
  branches                       Branch[]
  customerOrders                 CustomerOrder[]
  customerDeliveries             CustomerDelivery[]
  customerDeliveriesConfirmed    CustomerDelivery[]     @relation("CustomerDeliveryDeliveredBy")
  customerReturns                CustomerReturn[]       @relation("CustomerReturnSalesPerson")
  customerReturnsApproved        CustomerReturn[]       @relation("CustomerReturnApprovedBy")
  customerRecoveries             CustomerRecovery[]
  employeeCashLedgers            EmployeeCashLedger[]
  employeeCashTransfersSent      EmployeeCashTransfer[] @relation("EmployeeCashTransfersSent")
  employeeCashTransfersReceived  EmployeeCashTransfer[] @relation("EmployeeCashTransfersReceived")
  branchStockRequestsRequested   BranchStockRequest[]   @relation("BranchStockRequestedBy")
  branchStockRequestsApproved    BranchStockRequest[]   @relation("BranchStockApprovedBy")
  branchStockTransfersDispatched BranchStockTransfer[]  @relation("BranchStockTransferDispatchedBy")
  branchStockTransfersReceived   BranchStockTransfer[]  @relation("BranchStockTransferReceivedBy")
  branchStockTransfersCancelled  BranchStockTransfer[]  @relation("BranchStockTransferCancelledBy")
  branchStockReturnsRequested    BranchStockReturn[]    @relation("BranchStockReturnRequestedBy")
  branchStockReturnsApproved     BranchStockReturn[]    @relation("BranchStockReturnApprovedBy")
  salesPersonAssignment          SalesPersonAssignment?

  @@index([userId], map: "idx_hr_employees_user_id")
  @@index([status], map: "idx_hr_employees_status")
  @@map("hr_employees")
}

model EmployeeDocument {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  documentType String   @map("document_type")
  fileUrl      String   @map("file_url")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_employee_documents_employee")

  @@index([employeeId, documentType], map: "idx_hr_employee_documents_emp_type")
  @@map("hr_employee_documents")
}

model EmployeeContract {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String  @map("employee_id") @db.Uuid
  positionId    String? @map("position_id") @db.Uuid
  departmentId  String? @map("department_id") @db.Uuid
  designationId String? @map("designation_id") @db.Uuid

  // Employment classification
  contractType ContractType   @map("contract_type")
  status       ContractStatus @default(DRAFT) @map("status")

  // Contract duration
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  probationEndDate DateTime? @map("probation_end_date") @db.Date

  // Leave entitlement for this contract period — supports half-day increments
  totalLeaves    Decimal  @default(15) @map("total_leaves") @db.Decimal(5, 1)
  // Denormalized copy of the CURRENT salary revision's base salary, kept in sync on
  // contract create + revision activation — enables sorting the list by current salary (#1).
  currentSalary  Decimal? @map("current_salary") @db.Decimal(12, 2)
  consumedLeaves Decimal  @default(0) @map("consumed_leaves") @db.Decimal(5, 1)

  // Remarks
  notes String?

  // Audit
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_contracts_employee")
  position        Position?           @relation(fields: [positionId], references: [id], onUpdate: NoAction, map: "fk_hr_contracts_position")
  department      Department?         @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "fk_hr_contracts_department")
  designation     Designation?        @relation(fields: [designationId], references: [id], onUpdate: NoAction, map: "fk_hr_contracts_designation")
  salaryRevisions SalaryRevision[]
  allowances      ContractAllowance[]

  @@index([employeeId, status], map: "idx_hr_contracts_employee_status")
  @@index([status, endDate], map: "idx_hr_contracts_status_end_date")
  @@map("hr_employee_contracts")
}

model ContractAllowance {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String @map("contract_id") @db.Uuid

  allowanceType AllowanceType @map("allowance_type")
  amount        Decimal       @db.Decimal(15, 2)

  // Audit
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  contract EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_contract_allowances_contract")

  @@unique([contractId, allowanceType], map: "uniq_hr_contract_allowances_contract_type")
  @@index([contractId], map: "idx_hr_contract_allowances_contract")
  @@map("hr_contract_allowances")
}

model SalaryRevision {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String @map("contract_id") @db.Uuid

  // Effective from this date; latest CURRENT revision is the active salary
  effectiveDate DateTime @map("effective_date") @db.Date

  // Compensation details
  baseSalary      Decimal         @map("base_salary") @db.Decimal(15, 2)
  currency        String          @default("PKR") @map("currency") @db.VarChar(3)
  salaryFrequency SalaryFrequency @default(MONTHLY) @map("salary_frequency")

  // CURRENT = active salary; SUPERSEDED = replaced by a newer revision (never deleted)
  status SalaryRevisionStatus @default(CURRENT) @map("status")

  // Why the salary changed (e.g. "Annual increment", "Promotion")
  reason String?

  // Audit
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contract  EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_salary_revisions_contract")
  createdBy User?            @relation("SalaryRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_hr_salary_revisions_creator")

  @@index([contractId, status], map: "idx_hr_salary_revisions_contract_status")
  @@map("hr_salary_revisions")
}

model LeaveRequest {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String             @map("employee_id") @db.Uuid
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  durationType LeaveDurationType  @default(FULL_DAY) @map("duration_type")
  isPaid       Boolean            @default(true) @map("is_paid")
  totalDays    Decimal            @map("total_days") @db.Decimal(5, 1)
  // Actual dates within [startDate, endDate] this request counts against —
  // weekends and holidays are already excluded, so approvers see exactly
  // which dates count as leave without recomputing the range themselves.
  leaveDates   DateTime[]         @default([]) @map("leave_dates") @db.Date
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?            @map("created_by") @db.Uuid

  employee  Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_leave_requests_employee")
  approvals LeaveRequestApproval[]

  @@index([employeeId, startDate, endDate], map: "idx_hr_leave_requests_employee_dates")
  @@index([status], map: "idx_hr_leave_requests_status")
  @@map("hr_leave_requests")
}

model LeaveRequestApproval {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaveRequestId String              @map("leave_request_id") @db.Uuid
  approverId     String              @map("approver_id") @db.Uuid
  status         LeaveApprovalStatus @default(PENDING)
  remarks        String?
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_leave_request_approvals_request")

  @@unique([leaveRequestId, approverId], map: "uniq_hr_leave_request_approvals_request_approver")
  @@index([leaveRequestId], map: "idx_hr_leave_request_approvals_request")
  @@index([approverId], map: "idx_hr_leave_request_approvals_approver")
  @@map("hr_leave_request_approvals")
}

model LoanRequest {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId        String            @map("employee_id") @db.Uuid
  description       String?
  totalAmount       Decimal           @map("total_amount") @db.Decimal(15, 2)
  totalInstallments Int               @map("total_installments")
  // Running total of installments paid so far — kept in sync with LoanInstallment rows,
  // mirroring how EmployeeContract.consumedLeaves tracks leave balance.
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(15, 2)
  status            LoanRequestStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById       String?           @map("created_by") @db.Uuid

  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_loan_requests_employee")
  approvals    LoanRequestApproval[]
  installments LoanInstallment[]

  @@index([employeeId, status], map: "idx_hr_loan_requests_employee_status")
  @@index([status], map: "idx_hr_loan_requests_status")
  @@map("hr_loan_requests")
}

model LoanRequestApproval {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanRequestId String             @map("loan_request_id") @db.Uuid
  approverId    String             @map("approver_id") @db.Uuid
  status        LoanApprovalStatus @default(PENDING)
  remarks       String?
  decidedAt     DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loanRequest LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_loan_request_approvals_request")

  @@unique([loanRequestId, approverId], map: "uniq_hr_loan_request_approvals_request_approver")
  @@index([loanRequestId], map: "idx_hr_loan_request_approvals_request")
  @@index([approverId], map: "idx_hr_loan_request_approvals_approver")
  @@map("hr_loan_request_approvals")
}

model LoanInstallment {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanRequestId     String                @map("loan_request_id") @db.Uuid
  installmentNumber Int                   @map("installment_number")
  amount            Decimal               @db.Decimal(15, 2)
  // Month this installment is returned in, "YYYY-MM" (e.g. "2026-07") —
  // zero-padded so it sorts/filters correctly as a string. No payroll module
  // exists yet, so this is a self-contained plan owned by the loan module
  // itself; a future payroll module reads/updates it.
  returnMonth       String                @map("return_month") @db.VarChar(7)
  status            LoanInstallmentStatus @default(PENDING)
  // Stamped when this installment is actually paid off — for now just a
  // timestamp; a future payroll module can correlate it to a payslip by
  // returnMonth without a hard FK dependency.
  paidAt            DateTime?             @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loanRequest LoanRequest @relation(fields: [loanRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_loan_installments_request")

  @@unique([loanRequestId, installmentNumber], map: "uniq_hr_loan_installments_request_number")
  @@index([loanRequestId], map: "idx_hr_loan_installments_request")
  @@index([status], map: "idx_hr_loan_installments_status")
  @@index([returnMonth], map: "idx_hr_loan_installments_return_month")
  @@map("hr_loan_installments")
}

model Payroll {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  // Payroll period and payment details
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  paidMonth   String   @map("paid_month") @db.VarChar(7) // "2026-07" format for matching loan installments

  // Salary structure from active contract
  grossSalary     Decimal @map("gross_salary") @db.Decimal(15, 2) // base salary + allowancesTotal + bonusAmount
  allowancesTotal Decimal @default(0) @map("allowances_total") @db.Decimal(15, 2) // sum of contract allowances, snapshotted at creation — paid in full regardless of attendance
  bonusAmount     Decimal @default(0) @map("bonus_amount") @db.Decimal(15, 2) // ad-hoc amount added on top of base salary, DRAFT only
  bonusReason     String? @map("bonus_reason")
  salaryPerDay    Decimal @map("salary_per_day") @db.Decimal(15, 4)
  salaryPerHour   Decimal @map("salary_per_hour") @db.Decimal(15, 4)
  salaryPerMinute Decimal @map("salary_per_minute") @db.Decimal(15, 6)

  // Working days calculation
  totalCalendarDays Int     @map("total_calendar_days")
  holidays          Int     @default(0)
  weekends          Int     @default(0)
  paidLeaveDays     Decimal @default(0) @map("paid_leave_days") @db.Decimal(5, 1) // 1.5 = 1 full + 1 half
  unpaidLeaveDays   Decimal @default(0) @map("unpaid_leave_days") @db.Decimal(5, 1)
  workingDays       Decimal @map("working_days") @db.Decimal(5, 1) // totalCalendarDays - holidays - weekends - unpaidLeaveDays

  // Attendance deductions
  presentDays          Decimal @default(0) @map("present_days") @db.Decimal(5, 1)
  absentDays           Int     @default(0) @map("absent_days") // full days absent
  absentDaysDeduction  Decimal @default(0) @map("absent_days_deduction") @db.Decimal(15, 2) // absentDays × salaryPerDay
  timingMinutes        Int     @default(0) @map("timing_minutes") // late/early checkout minutes
  timingDeduction      Decimal @default(0) @map("timing_deduction") @db.Decimal(15, 2) // timingMinutes × salaryPerMinute
  unpaidLeaveDeduction Decimal @default(0) @map("unpaid_leave_deduction") @db.Decimal(15, 2) // unpaidLeaveDays × salaryPerDay
  loanDeduction        Decimal @default(0) @map("loan_deduction") @db.Decimal(15, 2) // sum of all loan installments for the month

  // Totals
  totalDeductions Decimal @map("total_deductions") @db.Decimal(15, 2)
  netPay          Decimal @map("net_pay") @db.Decimal(15, 2) // grossSalary - totalDeductions

  // Status workflow
  status       PayrollStatus @default(DRAFT)
  approvedById String?       @map("approved_by")
  approvedAt   DateTime?     @map("approved_at") @db.Timestamptz(6)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz(6)

  // Audit
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedById String   @map("updated_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_payroll_employee")
  approver User?    @relation(fields: [approvedById], references: [id], onDelete: NoAction, map: "fk_hr_payroll_approver")

  @@unique([employeeId, periodStart], map: "uniq_hr_payroll_employee_period")
  @@index([employeeId, status], map: "idx_hr_payroll_employee_status")
  @@index([status], map: "idx_hr_payroll_status")
  @@index([paidMonth], map: "idx_hr_payroll_paid_month")
  @@index([createdAt], map: "idx_hr_payroll_created_at")
  @@map("hr_payroll")
}

model Roster {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id")
  employeeId  String   @map("employee_id") @db.Uuid
  shiftId     String   @map("shift_id") @db.Uuid
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_rosters_employee")
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_hr_rosters_shift")

  @@unique([employeeId, date], map: "uniq_hr_rosters_employee_date")
  @@index([employeeId, date], map: "idx_hr_rosters_employee_date")
  @@index([tenantId, date], map: "idx_hr_rosters_tenant_id_date")
  @@map("hr_rosters")
