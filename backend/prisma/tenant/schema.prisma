  producedQuantity Float @default(0) @map("produced_quantity")

  status ProductionOrderStatus @default(DRAFT)

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  rawMaterialCost Float  @default(0) @map("raw_material_cost")
  additionalCost  Float  @default(0) @map("additional_cost")
  wasteInputCost  Float  @default(0) @map("waste_input_cost")
  totalCost       Float  @default(0) @map("total_cost")
  costPerUnit     Float? @map("cost_per_unit")

  notes       String?
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
