  @@index([customerId])
  @@index([salesPersonId])
  @@map("customer_recoveries")
}

// Finance/admin correction to a shop's distribution ledger — credit note reduces
// what the shop owes, debit note increases it. Posts immediately to
// CustomerLedger (type ADJUSTMENT) in the same transaction; does not touch
// legacy CustomerTransaction or employee cash.
enum CustomerLedgerAdjustmentType {
  CREDIT_NOTE
  DEBIT_NOTE
}

model CustomerLedgerAdjustment {
