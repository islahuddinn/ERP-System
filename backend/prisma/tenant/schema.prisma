model RawMaterialBatch {
  id            String  @id @default(uuid())
  batchNumber   String  @unique @map("batch_number")
  rawMaterialId String  @map("raw_material_id")
  grnItemId     String? @map("grn_item_id")
  siteId        String? @map("site_id")

  receivedQuantity  Float @default(0) @map("received_quantity")
  consumedQuantity  Float @default(0) @map("consumed_quantity")
  returnedQuantity  Float @default(0) @map("returned_quantity")
  availableQuantity Float @default(0) @map("available_quantity")
  reservedQuantity  Float @default(0) @map("reserved_quantity")

  unitCost          Float?    @map("unit_cost")
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  receivedDate      DateTime  @map("received_date")

  status RawMaterialBatchStatus @default(ACTIVE)
  notes  String?

  createdById String? @map("created_by_id")
  updatedById String? @map("updated_by_id")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  rawMaterial           RawMaterial                    @relation(fields: [rawMaterialId], references: [id])
  grnItem               GRNItem?                       @relation(fields: [grnItemId], references: [id])
  site                  Site?                          @relation(fields: [siteId], references: [id])
  qualityInspections    QualityControl[]
  inspections           RawMaterialBatchInspection[]
  stockLedgers          StockLedger[]
  stockBalances         WarehouseStockBalance[]
  consumptions          RawMaterialBatchConsumption[]
  returnItems           PurchaseReturnItem[]
  productionAllocations ProductionOrderMaterialBatch[]

  @@index([rawMaterialId])
  @@index([grnItemId])
  @@index([siteId])
  @@index([batchNumber])
  @@index([status])
  @@index([expiryDate])
  @@index([receivedDate])
  @@index([rawMaterialId, status, receivedDate])
  @@index([deletedAt])
  @@map("raw_material_batches")
}

model RawMaterialBatchConsumption {
