// Own enum for CustomerLedger — deliberately not CustomerTransactionType,
// whose SALE/PAYMENT naming is legacy POS/retail terminology and doesn't map
// clearly onto "a delivery happened" / "a recovery was collected". Each value
// here names the exact customer-management module that wrote the entry.
enum CustomerLedgerEntryType {
  DELIVERY // written by customer-deliveries when a delivery is marked DELIVERED (debit)
  RETURN // written by customer-returns (credit)
  RECOVERY // written by customer-recovery (credit)
  ADJUSTMENT // manual correction, no module writes this automatically yet
  OPENING_BALANCE // a shop's starting balance when first added to the ledger
}

enum EmployeeCashLedgerEntryType {
  RECOVERY_COLLECTED // written by customer-recovery for every payment mode (credit) — the collecting employee is in custody of whatever they collect until settled
  TRANSFER_IN // written on the receiving employee by employee-cash-transfer (credit)
  TRANSFER_OUT // written on the sending employee by employee-cash-transfer (debit)
  STOCK_RECEIVED // written on the receiving employee by branch-stock-transfers.confirmReceipt (debit) — they now owe the dispatching employee for this stock's value
  STOCK_DISPATCHED // written on the dispatching employee by branch-stock-transfers.confirmReceipt (credit) — the receiving employee now owes them for this stock's value
  ADJUSTMENT // manual correction, no module writes this automatically yet
  OPENING_BALANCE // an employee's starting cash-in-hand when first tracked
}

