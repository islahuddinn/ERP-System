# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/inventory?schema=public"

# Master Database (for multi-tenant management)
MASTER_DATABASE_URL="postgresql://postgres:password@localhost:5432/inventory_master?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Local seed / bootstrap scripts only — never commit the real value
SEED_ADMIN_PASSWORD=""

# Tenant Prisma pool (Phase 4). Keep connection_limit × connected tenants below Postgres max_connections.
TENANT_PRISMA_CONNECTION_LIMIT=5
TENANT_PRISMA_MAX_CLIENTS=50
TENANT_META_CACHE_TTL_MS=30000

# Load-test environments only — never set in production. Login is otherwise 5 attempts/min.
# LOAD_TEST_BYPASS_THROTTLE=true

# Application
PORT=5000
NODE_ENV=development

# CORS (for production, add your Vercel domain)
CORS_ORIGIN="http://localhost:3000"

# Production CORS example:
# CORS_ORIGIN="https://your-app.vercel.app"

# Encryption Key (for encrypting tenant database URLs)
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-this-to-a-strong-random-encryption-key-in-production"

# Cloudinary (tenant branding uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_BRANDING_FOLDER="tenant-branding"
CLOUDINARY_BASE_URL="https://res.cloudinary.com/your-cloud-name/image/upload"