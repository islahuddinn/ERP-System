{
  "name": "inventory-backend",
  "version": "0.0.1",
  "description": "Inventory Management System Backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "npm run generate:all",
    "build": "node init && npm run generate:all && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node init && node dist/main.js",
    "start:regenerate": "prisma generate --schema=prisma/master/schema.prisma && prisma generate --schema=prisma/tenant/schema.prisma && node dist/main.js",
    "start:dev": "npx nest start --watch",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "railway:build": "npm run generate:all && npx nest build -p tsconfig.build.json",
    "railway:start": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:smoke": "jest --config ./test/jest-smoke.json --runInBand --forceExit",
    "test:golden": "jest --runInBand --forceExit --testPathPattern=golden-rules",
    "master:generate": "prisma generate --schema=prisma/master/schema.prisma",
    "master:migrate": "prisma migrate dev --schema=prisma/master/schema.prisma",
    "master:deploy": "prisma migrate deploy --schema=prisma/master/schema.prisma",
    "master:studio": "prisma studio --schema=prisma/master/schema.prisma",
    "tenant:generate": "prisma generate --schema=prisma/tenant/schema.prisma",
    "tenant:migrate": "prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "tenant:deploy": "prisma migrate deploy --schema=prisma/tenant/schema.prisma",
    "tenant:studio": "prisma studio --schema=prisma/tenant/schema.prisma",
    "generate:all": "npm run master:generate && npm run tenant:generate",
    "deploy:all": "npm run master:deploy && npm run tenant:deploy",
    "db:clear": "ts-node scripts/clear-db.ts",
    "db:clear-safe": "ts-node scripts/clear-db-safe.ts",
    "db:clear-keep-users": "ts-node scripts/clear-db-keep-users.ts",
    "db:clear-keep-users-fast": "ts-node scripts/clear-db-keep-users-fast.ts",
    "db:clear-cash": "ts-node scripts/clear-cash-in-hand.ts",
    "seed:permissions": "ts-node scripts/seed-permissions.ts",
    "seed:default-roles": "ts-node scripts/seed-default-roles.ts",
    "seed:module-test-data": "ts-node scripts/seed-module-test-data.ts",
    "seed:demo-workflows": "ts-node scripts/seed-demo-workflows.ts",
    "seed:super-admin": "npx ts-node --transpile-only prisma/master/seed.ts",
    "tenant:schema-sync": "ts-node scripts/ensure-tenant-schema-sync.ts",
    "fix:cash-opening": "ts-node scripts/fix-cash-opening-balance.ts",
    "fix:cash-direct": "ts-node scripts/fix-cash-opening-direct.ts",
    "fix:cash-auto": "ts-node scripts/fix-cash-values-auto.ts",
    "migrate:enhanced-products": "ts-node scripts/migrate-enhanced-products.ts",
    "setup:logs": "ts-node scripts/setup-logs.ts",
    "tenants:delete:hard": "ts-node scripts/delete-all-tenants.ts",
    "demo:insert-data": "ts-node scripts/insert-dummy-data.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "chart.js": "^4.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^1.41.0",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "multer": "^1.4.5-lts.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^7.0.9",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "prisma": "^6.19.3",
    "react-chartjs-2": "^5.3.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.41",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "overrides": {
    "validator": "^13.11.0",
    "tmp": "^0.2.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "products.service.spec.ts",
      "products.validation.spec.ts",
      "locations.validation.spec.ts",
      "plants.validation.spec.ts",
      "uoms.validation.spec.ts",
      "companies.service.spec.ts",
      "dashboard.service.spec.ts",
      "stock-ledger.service.spec.ts"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
