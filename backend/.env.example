# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5434/inventory"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Local seed / bootstrap scripts only — never commit the real value
SEED_ADMIN_PASSWORD=""

# Tenant Prisma pool (Phase 4). Keep connection_limit × connected tenants below Postgres max_connections.
TENANT_PRISMA_CONNECTION_LIMIT=5
TENANT_PRISMA_MAX_CLIENTS=50
TENANT_META_CACHE_TTL_MS=30000

# Load-test environments only — never set in production. Login is otherwise 5 attempts/min.
# LOAD_TEST_BYPASS_THROTTLE=true

# Multi-tenant Configuration
MASTER_DATABASE_URL="postgresql://postgres:password@localhost:5434/factory_distribution_master"

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# Application Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (optional)
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@factory-distribution.com"

# File Upload Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-secret"
